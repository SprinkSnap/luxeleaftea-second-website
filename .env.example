# Database (PostgreSQL)
# Local development (matches scripts/setup-postgres or your own Postgres):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/luxleaftea?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/luxleaftea?schema=public"
# Production (Cloudflare Workers): use a serverless Postgres such as Neon.
#   DATABASE_URL = pooled connection (app runtime)
#   DIRECT_URL   = direct connection (Prisma Migrate / CLI)
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/luxleaftea?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/luxleaftea?schema=public&sslmode=require"

# Canonical production host (no trailing slash). Prefer luxeleaftea.ca or www —
# keep host redirects consistent with this value.
NEXT_PUBLIC_SITE_URL="https://luxeleaftea.ca"

# Locale / market / currency must agree with Stripe + Merchant Center.
# Canada-first defaults — confirm Stripe account supports CAD before going live.
NEXT_PUBLIC_LOCALE="en_CA"
NEXT_PUBLIC_MARKET="CA"
NEXT_PUBLIC_CURRENCY="CAD"
NEXT_PUBLIC_DEFAULT_COUNTRY="CA"

# Optional shipping thresholds (integer cents). Defaults: free at $50 CAD, else $6.95.
# NEXT_PUBLIC_FREE_SHIPPING_CENTS="5000"
# NEXT_PUBLIC_STANDARD_SHIPPING_CENTS="695"
# Tax: prefer Stripe Tax at payment — do not hard-code a flat Canadian rate.
# NEXT_PUBLIC_TAX_MODE="stripe"

# Customer support (only set verified values — Call UI is hidden until phone is set)
NEXT_PUBLIC_SUPPORT_EMAIL="hello@luxleaftea.com"
# NEXT_PUBLIC_SUPPORT_PHONE="+1XXXXXXXXXX"
# NEXT_PUBLIC_SUPPORT_HOURS="Weekdays 9am–5pm local time"
# NEXT_PUBLIC_SUPPORT_REPLY_TIMING="We typically reply within 1–2 business days."

# Optional verified social profiles for Organization sameAs
# NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/..."
# NEXT_PUBLIC_PINTEREST_URL="https://pinterest.com/..."

# Stripe (server secrets — never expose secret key to the browser)
# Checkout sessions use NEXT_PUBLIC_CURRENCY (cad). Express wallets appear when
# enabled in your Stripe Dashboard for this account.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Admin bootstrap (used by seed / docs only — rotate immediately)
ADMIN_EMAIL="admin@luxleaftea.com"
ADMIN_PASSWORD=""

# Inventory / supplier notifications (modular providers)
REORDER_NOTIFY_CHANNEL="EMAIL"
INVENTORY_ALERT_EMAIL="ops@luxleaftea.com"
EMAIL_WEBHOOK_URL=""
SMS_WEBHOOK_URL=""
SLACK_WEBHOOK_URL=""
WECOM_WEBHOOK_URL=""

# Optional AI provider (assistant works with catalog-grounded local logic without this)
AI_API_KEY=""
AI_API_BASE_URL=""
AI_MODEL=""
