# Database (PostgreSQL)
# Local development (matches scripts/setup-postgres or your own Postgres):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/luxleaftea?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/luxleaftea?schema=public"
# Production (Cloudflare Workers): use a serverless Postgres such as Neon.
#   DATABASE_URL = pooled connection (app runtime)
#   DIRECT_URL   = direct connection (Prisma Migrate / CLI)
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/luxleaftea?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/luxleaftea?sslmode=require"

# Public site URL used for canonical URLs, sitemap, Stripe redirects, JSON-LD
NEXT_PUBLIC_SITE_URL="https://www.luxeleaftea.ca"

# Stripe (server secrets — never expose secret key to the browser)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Admin bootstrap (used by seed / docs only — rotate immediately)
ADMIN_EMAIL="admin@luxleaftea.com"
ADMIN_PASSWORD=""

# Inventory / supplier notifications (modular providers)
REORDER_NOTIFY_CHANNEL="EMAIL"
INVENTORY_ALERT_EMAIL="ops@luxleaftea.com"
EMAIL_WEBHOOK_URL=""
SMS_WEBHOOK_URL=""
SLACK_WEBHOOK_URL=""
WECOM_WEBHOOK_URL=""

# Optional AI provider (assistant works with catalog-grounded local logic without this)
AI_API_KEY=""
AI_API_BASE_URL=""
AI_MODEL=""
