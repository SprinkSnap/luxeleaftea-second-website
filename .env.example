# Database
# Local/dev SQLite:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/luxleaftea?schema=public"

# Public site URL used for canonical URLs, sitemap, Stripe redirects, JSON-LD
NEXT_PUBLIC_SITE_URL="https://www.luxleaftea.com"

# Stripe (server secrets — never expose secret key to the browser)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Admin bootstrap (used by seed / docs only — rotate immediately)
ADMIN_EMAIL="admin@luxleaftea.com"
ADMIN_PASSWORD=""

# Inventory / supplier notifications (modular providers)
REORDER_NOTIFY_CHANNEL="EMAIL"
INVENTORY_ALERT_EMAIL="ops@luxleaftea.com"
EMAIL_WEBHOOK_URL=""
SMS_WEBHOOK_URL=""
SLACK_WEBHOOK_URL=""
WECOM_WEBHOOK_URL=""

# Optional AI provider (assistant works with catalog-grounded local logic without this)
AI_API_KEY=""
AI_API_BASE_URL=""
AI_MODEL=""
