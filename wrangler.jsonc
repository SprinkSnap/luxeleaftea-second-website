{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lux-leaf-tea",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  }
  // Secrets (set with `wrangler secret put <NAME>`), not committed:
  //   DATABASE_URL          - pooled Postgres connection string. Use a serverless
  //                           Postgres such as Neon (recommended) so the edge
  //                           runtime can connect over HTTP/WebSocket, e.g.
  //                           postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/luxleaftea?sslmode=require
  //   STRIPE_SECRET_KEY     - optional; enables real Stripe Checkout
  //   STRIPE_WEBHOOK_SECRET - optional; verifies /api/webhooks/stripe
  //
  // Non-secret vars can go in the Cloudflare dashboard or a "vars" block:
  // "vars": {
  //   "NEXT_PUBLIC_SITE_URL": "https://your-worker.workers.dev",
  //   "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "",
  //   "REORDER_NOTIFY_CHANNEL": "EMAIL"
  // }
}
